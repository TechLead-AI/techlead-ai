{
  "name": "tech-lead-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:preview": "NEXT_DIST_DIR=.next-preview next dev",
    "clean": "rm -rf .next .next-preview",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "postinstall": "prisma generate",
    "release": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "onboard": "tsx scripts/onboard-repo.ts",
    "check:github": "tsx scripts/check-github-app.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.7",
    "next": "^15.1.3",
    "octokit": "^4.0.2",
    "pg-boss": "^10.1.5",
    "prisma": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
