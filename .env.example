# Local Postgres (matches docker-compose.yml; host port 5433)
DATABASE_URL="postgresql://techleadai:techleadai@localhost:5433/techleadai?schema=public"

# Anthropic API key for the review engine (Step 5). Leave blank to use the
# built-in fake reviewer for offline demos.
ANTHROPIC_API_KEY=""

# Which Claude model the review engine uses.
REVIEW_MODEL="claude-sonnet-4-6"

# GitHub App credentials (live end-to-end). Optional for the demo.
# See CONNECT_GITHUB.md for how to create the App and fill these in.
#  - GITHUB_APP_ID: the numeric App ID from the App's settings page.
#  - GITHUB_APP_PRIVATE_KEY: the generated .pem. Paste it on one line with
#    literal "\n" between lines (the client converts them back to newlines).
#  - GITHUB_WEBHOOK_SECRET: the secret you set on the App's webhook; must match
#    exactly or every delivery is rejected with a 401.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
